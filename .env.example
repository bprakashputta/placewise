# Copy to .env and fill in. Never commit .env.
# --- App ---
APP_ENV=dev                      # dev turns on API docs (localhost:8000/docs) and /dev/* routes. Use prod for the shared demo
APP_SECRET_KEY=                  # generate: openssl rand -hex 32
DAILY_LLM_SPEND_CAP_USD=10
# --- Database (runs in the db container) ---
POSTGRES_PASSWORD=               # URL-safe characters only. Generate: openssl rand -hex 24
# --- LLM / AI ---
PLACEWISE_ANTHROPIC_TEST_API_KEY=
PLACEWISE_VOYAGE_TEST_API_KEY=
# --- LangSmith ---
PLACEWISE_LANGSMITH_TEST_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=placewise
# --- Demo portal logins (usernames: admin / recruiter); generate: openssl rand -base64 12 ---
PLACEWISE_DEMO_ADMIN_PASSWORD=
PLACEWISE_DEMO_RECRUITER_PASSWORD=
COOKIE_SECURE=false

# --- Public demo link / cloud server (Block 9) ---
# Cloudflare token scoped to editing Workers (scripts/public-link.sh deploys the Worker with it)
CLOUDFLARE_API_TOKEN=
# Daily AI spend cap when running docker-compose.public.yml (default 10)
PUBLIC_DAILY_LLM_SPEND_CAP_USD=10
# Cloud server only: direct HTTPS route for Caddy, e.g. 1-2-3-4.sslip.io for IP 1.2.3.4
PUBLIC_DIRECT_HOST=
# Cloud server only: random secret shared by the Worker (ORIGIN_SECRET), Caddy and the api. openssl rand -hex 24
ORIGIN_SHARED_SECRET=
