# Placewise system architecture (D2). Render: docker run ... terrastruct/d2:v0.7.1 --layout elk src/architecture.d2 architecture.svg
vars: {d2-config: {theme-id: 0; pad: 30}}
direction: down

classes: {
  svc: {style: {fill: "#EEF2FF"; stroke: "#4F46E5"; border-radius: 10; font-color: "#1E1B4B"; stroke-width: 2; font-size: 15}}
  store: {shape: cylinder; style: {fill: "#ECFDF5"; stroke: "#059669"; font-color: "#064E3B"; stroke-width: 2; font-size: 15}}
  ext: {style: {fill: "#FFF7ED"; stroke: "#EA580C"; border-radius: 10; font-color: "#7C2D12"; stroke-width: 2; font-size: 15}}
  planned: {style: {fill: "#F8FAFC"; stroke: "#94A3B8"; stroke-dash: 4; border-radius: 10; font-color: "#64748B"; font-size: 14}}
  group: {style: {fill: "#FFFFFF"; stroke: "#CBD5E1"; border-radius: 16; font-size: 18; bold: true}}
}

users: Users {
  class: group
  recruiter: "Recruiter / Admin\n(browser)" {class: svc}
  sources: "Resume sources\nApply page · email · job boards\n(via n8n, Block 8)" {class: planned}
}

app: "Placewise (Docker Compose)" {
  class: group
  web: "Web portal\nNext.js 16 · shadcn/ui" {class: svc}
  api: "API\nFastAPI · stateless · signed-in users only\ncandidates · upload · job orders\nAsk chat (route → RAG) · matching runs" {class: svc}
  worker: "Ingest workers ×3\n4 job slots each\nLangGraph pipeline" {class: svc}
  web -> api: "/api/* only"
  api -> worker: "job queue in Postgres\n(SKIP LOCKED)" {style.stroke-dash: 3}
}

data: Data {
  class: group
  db: "Postgres 17 + pgvector\npeople · resume files · profiles\nsection chunks (HNSW + full-text)\njob orders · matches · conversations\nusers · job queue · LLM cost log" {class: store}
  files: "Resume files\nstorage volume (uploads)\n+ seed resumes (read-only)" {class: store}
}

ai: "External AI services" {
  class: group
  claude: "Anthropic\nSonnet 5.5: extraction, answers, scoring\nHaiku 5.5: query understanding, routing" {class: ext}
  voyage: "Voyage AI\nvoyage-4-large embeddings\nrerank-3" {class: ext}
  langsmith: "LangSmith\ntraces · evals" {class: ext}
}

dev: "Dev tools (on demand)" {
  class: group
  seed: "seed container\nsynthetic data · evals" {class: svc}
  truth: "answer key\ndata/seed/truth\n(mounted here only)" {class: store}
  seed -> truth
}

users.recruiter -> app.web
users.sources -> app.api {class: planned; style.stroke-dash: 4}
app.api -> data.db: "read · enqueue"
app.api -> data.files: "save upload"
app.worker -> data.db: "claim job · store profile"
app.worker -> data.files: "read file"
app.worker -> ai.claude
app.worker -> ai.voyage
app.worker -> ai.langsmith: "one trace per resume" {style.stroke-dash: 3}
app.api -> ai.claude: "Ask · job orders · matching"
app.api -> ai.voyage: "search · rerank"
app.api -> ai.langsmith: "one trace per question / run" {style.stroke-dash: 3}
dev.seed -> data.db: "evals: stored vs key" {style.stroke-dash: 3}
