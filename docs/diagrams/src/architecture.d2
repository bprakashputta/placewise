# Placewise system architecture (D2). Render: docker run ... terrastruct/d2:v0.7.1 --layout elk src/architecture.d2 architecture.svg
vars: {d2-config: {theme-id: 0; pad: 30}}
direction: down

classes: {
  svc: {style: {fill: "#EEF2FF"; stroke: "#4F46E5"; border-radius: 10; font-color: "#1E1B4B"; stroke-width: 2; font-size: 15}}
  store: {shape: cylinder; style: {fill: "#ECFDF5"; stroke: "#059669"; font-color: "#064E3B"; stroke-width: 2; font-size: 15}}
  ext: {style: {fill: "#FFF7ED"; stroke: "#EA580C"; border-radius: 10; font-color: "#7C2D12"; stroke-width: 2; font-size: 15}}
  planned: {style: {fill: "#F8FAFC"; stroke: "#94A3B8"; stroke-dash: 4; border-radius: 10; font-color: "#64748B"; font-size: 14}}
  group: {style: {fill: "#FFFFFF"; stroke: "#CBD5E1"; border-radius: 16; font-size: 18; bold: true}}
}

users: Users {
  class: group
  recruiter: "Recruiter / Admin\n(browser)" {class: svc}
  sources: "Resume sources\nApply page · email · job boards\n(via n8n, Block 8)" {class: planned}
}

app: "Placewise (Docker Compose)" {
  class: group
  web: "Web portal\nNext.js 16 · shadcn/ui" {class: svc}
  api: "API\nFastAPI · stateless" {class: svc}
  worker: "Ingest workers ×N\nLangGraph pipeline" {class: svc}
  web -> api: "/api/* only"
  api -> worker: "job queue\n(Postgres)" {style.stroke-dash: 3}
}

data: Data {
  class: group
  db: "Postgres 17 + pgvector\nprofiles · section chunks (HNSW + full-text)\njob queue · LLM cost log" {class: store}
}

ai: "External AI services" {
  class: group
  claude: "Anthropic\nClaude Sonnet 5.5\nprofile extraction" {class: ext}
  voyage: "Voyage AI\nvoyage-4-large\nembeddings" {class: ext}
  langsmith: "LangSmith\ntraces · evals" {class: ext}
}

users.recruiter -> app.web
users.sources -> app.api: "upload / webhook" {style.stroke-dash: 4}
app.api -> data.db: "read / write"
app.worker -> data.db: "store profile + chunks"
app.worker -> ai.claude
app.worker -> ai.voyage
app.worker -> ai.langsmith: "every run traced" {style.stroke-dash: 3}
