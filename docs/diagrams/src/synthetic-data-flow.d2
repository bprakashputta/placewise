# Synthetic data flow (Block 1): seed CLI steps.
vars: {d2-config: {theme-id: 0; pad: 30}}
direction: right

classes: {
  code: {style: {fill: "#ECFDF5"; stroke: "#059669"; border-radius: 10; font-color: "#064E3B"; stroke-width: 2}}
  ai: {style: {fill: "#FFF7ED"; stroke: "#EA580C"; border-radius: 10; font-color: "#7C2D12"; stroke-width: 2}}
  node: {style: {fill: "#EEF2FF"; stroke: "#4F46E5"; border-radius: 10; font-color: "#1E1B4B"; stroke-width: 2}}
  check: {shape: diamond; style: {fill: "#F8FAFC"; stroke: "#64748B"; font-color: "#334155"; stroke-width: 2}}
}

facts: "facts\ncode, seed 42" {class: code}
write: "write\nHaiku, structured" {class: ai}
check: "checks\npass?" {class: check}
noise: "noise\ncode" {class: code}
render: "render\nPDF · DOCX · TXT" {class: code}
jo: "job orders\n+ targeted candidates" {class: code}
key: "answer key\nrelevance.jsonl" {class: code}
publish: "publish\naggregates + dev showcase" {class: code}
page: "Seed page\ndev only" {class: node}

facts -> write -> check
check -> write: "no, max 2 retries" {style: {stroke: "#DC2626"; stroke-dash: 3}}
check -> noise: "yes"
noise -> render -> jo -> key -> publish -> page
